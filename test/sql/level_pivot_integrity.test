# name: test/sql/level_pivot_integrity.test
# description: Detect table files whose keys are stored out of order
# group: [sql]

#
# leveldb assumes every table file holds its keys in sorted order: the merging
# iterator and the DB iterator both skip anything that sorts below what they
# already emitted. A table written out of order therefore hides whole runs of
# live keys from reads while the data sits intact on disk, and each compaction
# that reads it passes the disorder on.
#
# TableBuilder::Add only asserted sortedness under a debug build, so a release
# build accepted unsorted input silently. This is the corruption reported in
# Nexus-Mods/Vortex#23981, where a full scan returned 167k of 309k live keys.
#
# The fixture is generated by scripts/make_unsorted_fixture.py and holds 24
# keys across two tables; opening it in leveldb returns only 16, because the
# unsorted table's first run is skipped. The check reads the table files
# directly and never opens the store, so it neither takes the lock nor
# triggers recovery - which is also why the tests can point it at the
# fixture in the source tree without modifying it.

require level_pivot

# ---------------------------------------------------------------------------
# a healthy store reports nothing
# ---------------------------------------------------------------------------

statement ok
ATTACH '__TEST_DIR__/integrity_healthy' AS h (TYPE level_pivot, CREATE_IF_MISSING true);

statement ok
CALL level_pivot_create_table('h', 'kv', NULL, ['key', 'value'], table_mode := 'raw');

statement ok
INSERT INTO h.kv SELECT 'key_' || printf('%06d', i), 'value_' || i FROM range(20000) t(i);

statement ok
DETACH h;

# reopening replays the write-ahead log into a table file, so there is
# something for the check to read
statement ok
ATTACH '__TEST_DIR__/integrity_healthy' AS h (TYPE level_pivot);

statement ok
DETACH h;

query I
SELECT count(*) FROM level_pivot_check_integrity('__TEST_DIR__/integrity_healthy');
----
0

# ---------------------------------------------------------------------------
# an unsorted table is named, and the sorted table beside it is not - so the
# check is reading both and judging them apart
# ---------------------------------------------------------------------------

query II
SELECT file, problem
FROM level_pivot_check_integrity('__WORKING_DIRECTORY__/test/fixtures/unsorted_table')
ORDER BY file;
----
000005.ldb	unsorted_keys

# the detail carries the number of out-of-order transitions and the entry
# count, so a field report says how bad the damage is
query I
SELECT detail LIKE '%2 out-of-order transitions in 16 entries%'
FROM level_pivot_check_integrity('__WORKING_DIRECTORY__/test/fixtures/unsorted_table');
----
true

# ---------------------------------------------------------------------------
# a path that is not a store is an error, not a silent pass
# ---------------------------------------------------------------------------

statement error
SELECT * FROM level_pivot_check_integrity('__TEST_DIR__/does_not_exist_at_all');
----
cannot read store directory

# ---------------------------------------------------------------------------
# a directory that is not a store fails loudly: reporting no problems for it
# would read as a clean bill of health for a mistyped path
# ---------------------------------------------------------------------------

statement error
SELECT * FROM level_pivot_check_integrity('__TEST_DIR__');
----
is not a leveldb store
